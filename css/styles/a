.work-model-2 .row:nth-child(2) div:nth-child(3) { background:url('https://picsum.photos/300/200?11'); }

/* MODEL 3 */
.work-model-3 .hero { background:url('../../assets/images/site/Nagai_Book_Fair/Book fair promo video.webp'); margin-bottom:12px; }
.work-model-3 .two { display:flex; gap:12px; }
.work-model-3 .two div:nth-child(1) { background:url('https://picsum.photos/300/200?13'); }
.work-model-3 .two div:nth-child(2) { background:url('https://picsum.photos/300/200?14'); }

