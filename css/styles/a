/* MODEL 2 */
.work-model-2 .row { display: flex; gap: 12px; margin-bottom: 12px; }
.work-model-2 .row div { flex:1; }
.work-model-2 .row:nth-child(1) div:nth-child(1) { background:url('https://picsum.photos/300/200?6'); }
